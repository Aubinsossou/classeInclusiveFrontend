# Environnement de MESURE RESPONSIVE uniquement.
#
# L'API simulée (tools/responsive/mock-server.mjs) sert à la fois le build
# statique et les réponses JSON. Pointer VITE_API_URL vers CE serveur garantit
# une origine unique : ni CORS, ni port backend injoignable, et la mesure porte
# sur le rendu réel des pages remplies.
#
# Ne JAMAIS utiliser pour un build de production.
VITE_API_URL=http://localhost:4180
